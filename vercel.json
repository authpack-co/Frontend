{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/blog/o-que-e-o-authpack", "destination": "/blog/o-que-e-o-niango/", "permanent": true },
    { "source": "/blog/o-que-e-o-authpack/", "destination": "/blog/o-que-e-o-niango/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/collection/:path*", "destination": "/app.html" },
    { "source": "/collection", "destination": "/app.html" },
    { "source": "/shared/:path*", "destination": "/app.html" },
    { "source": "/shared", "destination": "/app.html" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/invite/:path*", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" }
  ]
}
